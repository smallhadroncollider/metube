# Google OAuth (Device Authorization Flow)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# Duration filters (seconds)
MIN_DURATION=60
MAX_DURATION=3600

# Server
PORT=3000
SESSION_SECRET=a-random-secret-string

# Auto-sync interval (minutes)
# How often the backend automatically syncs YouTube channels for new videos.
# Set to 0 or omit to disable auto-sync (manual sync only).
REFRESH_INTERVAL_MINUTES=60

# Playlist
YOUTUBE_PLAYLIST_ID=your-playlist-id
